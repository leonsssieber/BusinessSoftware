# Copy to .env (shared by all products) and/or .env.<product>, e.g. .env.quoterunner, for values
# that differ per product. Product files win over .env; real environment variables win over both.
# Everything is optional in development: without keys, AI falls back to the built-in parsers,
# email goes to a dev outbox (/api/dev/outbox), and plans can be switched without Stripe.

# --- Server (set per product in production) ---
# NODE_ENV=production
# PORT=8101
# APP_URL=https://quoterunner.example.com    # public URL; used in emails and quote links
# DATA_DIR=data/quoterunner                   # SQLite database lives here
# TRUST_PROXY=1                               # behind a reverse proxy that sets X-Forwarded-For

# --- AI (Anthropic) ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5-5             # default; any current Claude model id works

# --- Billing (Stripe) ---
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...             # webhook endpoint: <APP_URL>/api/billing/webhook
# One price id per plan and interval: STRIPE_PRICE_<PLAN>_<MONTH|YEAR>
# STRIPE_PRICE_PRO_MONTH=price_...
# STRIPE_PRICE_PRO_YEAR=price_...
# STRIPE_PRICE_TEAM_MONTH=price_...
# STRIPE_PRICE_TEAM_YEAR=price_...

# --- Email (Resend) ---
# RESEND_API_KEY=re_...
# MAIL_FROM=QuoteRunner <hello@quoterunner.example.com>

# --- Inbound email: suppliers reply to quotes+<token>@INBOUND_EMAIL_DOMAIN (QuoteRunner) ---
# Point your provider's inbound webhook (Postmark or any JSON webhook) at
# <APP_URL>/api/inbound/email?secret=<INBOUND_EMAIL_SECRET>
# INBOUND_EMAIL_DOMAIN=in.quoterunner.example.com
# INBOUND_EMAIL_SECRET=a-long-random-string

# --- Admin ---
# ADMIN_EMAILS=you@example.com                # can read /api/admin/stats
